PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Supabase Auth project URL. Tokens are verified against this project's JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
# Leave empty to use an ephemeral MongoDB instance locally. Use a real MongoDB
# connection string when you need data to persist between backend restarts.
MONGODB_URI=
# Match the existing Atlas database name exactly, including capitalization.
MONGODB_DB_NAME=Giggo
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-development-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=12

# Private verification-document storage. Files are kept outside public static assets.
VERIFICATION_MAX_FILE_MB=5
UPLOAD_DIR=

# Required only when running `npm run bootstrap:admin`; never commit real values.
ADMIN_NAME=Giggo Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
